# Copy this file to .env and fill in your own values.
# Get a Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Gmail App Password for sending password-reset emails: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword

# PostgreSQL connection string (e.g. from Neon, Supabase, Railway...).
# Leave unset to fall back to local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Never share this value or commit it to git.
SECRET_KEY=replace-with-your-own-random-secret-key

# Set to True for local development, False in production.
DEBUG=True

# Comma-separated list of domains allowed to serve this site.
# Only needed (and should be set) once DEBUG=False in production.
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
